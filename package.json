{
  "name": "forge",
  "version": "0.1.0",
  "private": true,
  "description": "Forge — describe an app in plain language and watch it run in a live, sandboxed preview.",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:mock": "cross-env PROVIDER=mock tsx server.ts",
    "build": "next build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -f docker/Dockerfile.sandbox -t vibe-sandbox:latest docker",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.124.0",
    "@google/genai": "2.21.0",
    "@next/env": "14.2.35",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "dockerode": "4.0.12",
    "http-proxy-middleware": "3.0.7",
    "lucide-react": "0.446.0",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "simple-git": "3.36.0",
    "tar-stream": "3.2.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/dockerode": "4.0.1",
    "@types/node": "22.20.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/tar-stream": "3.1.4",
    "autoprefixer": "10.5.5",
    "cross-env": "7.0.3",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
