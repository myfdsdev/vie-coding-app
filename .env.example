# Copy to .env.local and fill in what you need. Never commit real keys.

# Model provider: mock | anthropic | gemini
# Unset = anthropic if ANTHROPIC_API_KEY is set, else gemini if GEMINI_API_KEY is set, else mock.
PROVIDER=

ANTHROPIC_API_KEY=
# Code model. claude-sonnet-5 is cheaper ($2/$10 per MTok vs $5/$25).
ANTHROPIC_MODEL=claude-opus-5
# Server-side refusal fallbacks on Opus 5 / Fable models. Set to "off" to disable.
ANTHROPIC_FALLBACKS=on

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Builder UI + preview proxy port. Previews are served at http://sbx-<id>.<PREVIEW_DOMAIN>:<PORT>
PORT=3000
# lvh.me resolves every subdomain to 127.0.0.1. If your DNS blocks that, use "localhost".
PREVIEW_DOMAIN=lvh.me
# The nginx gateway from docker/docker-compose.yml that can reach sandbox containers.
PREVIEW_GATEWAY_URL=http://127.0.0.1:3100
